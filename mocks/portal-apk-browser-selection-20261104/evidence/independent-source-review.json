  "baselineEquivalence": {
    "qualified": "The extracted helper reads metadata from the public source and returns that same non-owned File, matching the original browser scan-to-confirm-to-installer address handoff. It is not the original Activity method or the original rollback APK execution.",
    "originalWitness": "Captured original LocalApk retains public File plus scan-time metadata; selection retains that row, and confirm later passes apk.file to HeadlessInstaller.",
    "testFailureWording": "Six XML failures and two controls. The deletion case is FileNotFoundException; replacement is ArrayComparisonFailure; remaining four are AssertionError. Zero XML errors/skips does not make all six assertion failures.",
    "missingSourceLimit": "The missing-source test uses a fake metadata callback that can return metadata without reading bytes. Its baseline failure demonstrates the extracted helper boundary, not PackageManager behavior or original scan admission."
  },
  "reviewedOwnership": [
    {
      "lines": "ApkBrowserSelection.kt:19-29",
      "finding": "Creates a unique IncomingApkSnapshot before metadata, reads metadata from that same copy, returns that owned File. Null metadata or thrown metadata callback removes only that copy in finally."
    },
    {
      "lines": "IncomingApkSnapshot.kt:15-30",
      "finding": "Existing byte-identical helper uses a unique cache file and removes its own incomplete output on source-open/copy/close failure."
    },
    {
      "lines": "ApkBrowserActivity.kt:125-150",
      "finding": "Preparation is serialized by preparing state, starts UNDISPATCHED, performs copy/parser work on IO, and assigns pending inside IO. A cancelled withContext delivery therefore retains pending for finally cleanup. No suspension occurs between successful return, selected transfer and pending=null."
    },
    {
      "lines": "ApkBrowserActivity.kt:68-74,158-174",
      "finding": "Selected is a remembered delegated mutable state. DisposableEffect reads its current value at disposal. Dismiss, explicit Cancel, replacement and paused confirmation each close the selected ownership."
    },
    {
      "lines": "ApkBrowserActivity.kt:169-184;HeadlessInstaller.kt:100-125",
      "finding": "Confirmation clears selected, then UNDISPATCHED launch enters try/finally before dispatching blocking installer IO. Disposal no longer owns the confirmed snapshot; cancellation waits for the structured IO child, then closes selection. The unchanged installer opens and stages selection.file synchronously before returning."
    },
    {
      "lines": "ApkBrowserActivity.kt:132-143,180,220-240",
      "finding": "Package archive metadata/label/icon read from snapshot contents; displayFile remains original path for filename/status. The exact prepared File is handed to HeadlessInstaller. Scan parser extraction preserves existing fallback fields and directory/filter/sort behavior."
    },
    {
      "lines": "ApkBrowserActivity.kt:138-146,181-183",
      "finding": "Preparation errors use fixed user-facing text. Existing installation status/error handling remains, with added owned-copy finally cleanup; installer, daemon, Store and incoming Activity are unchanged."
    }
  ],
