+package com.immortal.launcher
+
+import android.app.Activity
+import android.app.Application
+import android.os.Build
+import android.os.Bundle
+import android.os.Handler
+import android.os.Looper
+import android.view.FrameMetrics
+import android.view.Window
+
+/**
+ * Keep the Dream's frozen surface while its retained caller resumes and submits a frame.
+ * A bounded fallback prevents a missing caller from stranding the user in the Dream.
+ * Cancellation removes every observer without delivering the completion callback.
+ */
+internal fun awaitDreamCallerFrame(application: Application, complete: (String) -> Unit): () -> Unit {
+    val handler = Handler(Looper.getMainLooper())
+    val requestedAt = System.nanoTime()
+    var finished = false
+    var observedWindow: Window? = null
+    var frameListener: Window.OnFrameMetricsAvailableListener? = null
+    lateinit var lifecycle: Application.ActivityLifecycleCallbacks
+    lateinit var timeout: Runnable
+
+    fun clearWindow() {
+        if (Build.VERSION.SDK_INT >= 24) {
+            frameListener?.let { listener -> observedWindow?.removeOnFrameMetricsAvailableListener(listener) }
+        }
+        frameListener = null
+        observedWindow = null
+    }
+
+    fun cleanup() {
+        handler.removeCallbacks(timeout)
+        application.unregisterActivityLifecycleCallbacks(lifecycle)
+        clearWindow()
+    }
+
+    fun finish(reason: String) {
+        if (finished) return
+        finished = true
+        cleanup()
+        complete(reason)
+    }
+
+    lifecycle = object : Application.ActivityLifecycleCallbacks {
+        override fun onActivityResumed(activity: Activity) {
+            if (activity is PhotoFramePreviewActivity || finished) return
+            clearWindow()
+            val caller = activity.window
+            if (!caller.decorView.isAttachedToWindow || Build.VERSION.SDK_INT < 26) return
+            lateinit var listener: Window.OnFrameMetricsAvailableListener
+            listener = Window.OnFrameMetricsAvailableListener { window, metrics, _ ->
+                // Ignore queued reports belonging to frames produced before this tap.
+                if (observedWindow === window && frameListener === listener &&
+                    metrics.getMetric(FrameMetrics.INTENDED_VSYNC_TIMESTAMP) >= requestedAt) {
+                    finish("caller-frame")
+                }
+            }
+            observedWindow = caller
+            frameListener = listener
+            caller.addOnFrameMetricsAvailableListener(listener, handler)
+            caller.decorView.postInvalidateOnAnimation()
+        }
+        override fun onActivityPaused(activity: Activity) {
+            if (observedWindow === activity.window) clearWindow()
+        }
+        override fun onActivityDestroyed(activity: Activity) {
+            if (observedWindow === activity.window) clearWindow()
+        }
+        override fun onActivityCreated(activity: Activity, state: Bundle?) = Unit
+        override fun onActivityStarted(activity: Activity) = Unit
+        override fun onActivityStopped(activity: Activity) = Unit
+        override fun onActivitySaveInstanceState(activity: Activity, state: Bundle) = Unit
+    }
+    timeout = Runnable { finish("caller-timeout") }
+    application.registerActivityLifecycleCallbacks(lifecycle)
+    handler.postDelayed(timeout, 1_000L)
+    return {
+        if (!finished) {
+            finished = true
+            cleanup()
+        }
+    }
+}
