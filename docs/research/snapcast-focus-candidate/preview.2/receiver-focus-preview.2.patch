+    void handleControlMessage(Message msg) {
+        String error = null;
+        String[] packages = getPackageManager().getPackagesForUid(msg.sendingUid);
+        boolean allowed = false;
+        if (packages != null) {
+            for (String name : packages) {
+                if ("com.immortal.launcher".equals(name) ||
