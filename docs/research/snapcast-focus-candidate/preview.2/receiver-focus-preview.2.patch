+package de.badaix.snapcast;
+
+import android.app.Service;
+import android.content.ComponentName;
+import android.content.Context;
+import android.content.Intent;
+import android.content.ServiceConnection;
+import android.os.Bundle;
+import android.os.Handler;
+import android.os.IBinder;
+import android.os.Looper;
+import android.os.Message;
+import android.os.Messenger;
+import android.os.RemoteException;
+
+/**
+ * Separate bind-only endpoint: Android caches onBind's first Binder per service.
+ * Binding creates the receiver component but cannot start its native renderer.
+ */
+public final class FocusControlService extends Service {
+    private SnapclientService receiver;
+    private boolean bound;
+    private final ServiceConnection connection = new ServiceConnection() {
+        @Override
+        public void onServiceConnected(ComponentName name, IBinder binder) {
+            receiver = ((SnapclientService.LocalBinder) binder).getService();
+        }
+
+        @Override
+        public void onServiceDisconnected(ComponentName name) {
+            receiver = null;
+        }
+    };
+    private final Messenger messenger = new Messenger(new Handler(Looper.getMainLooper()) {
+        @Override
+        public void handleMessage(Message message) {
+            if (receiver != null) {
+                // Preserve Message.sendingUid; authorization is checked in the receiver.
+                receiver.handleControlMessage(message);
+            } else if (message.replyTo != null) {
+                Message reply = Message.obtain();
+                reply.what = message.what;
+                Bundle data = new Bundle();
+                data.putString("error", "not_ready");
+                data.putLong("requestId", message.getData().getLong("requestId"));
+                reply.setData(data);
+                try {
+                    message.replyTo.send(reply);
+                } catch (RemoteException ignored) {
+                }
+            }
+        }
+    });
+
+    @Override
+    public void onCreate() {
+        super.onCreate();
+        bound = bindService(new Intent(this, SnapclientService.class), connection,
+                Context.BIND_AUTO_CREATE);
+    }
+
+    @Override
+    public IBinder onBind(Intent intent) {
+        return messenger.getBinder();
+    }
+
+    @Override
+    public void onDestroy() {
+        if (bound)
+            unbindService(connection);
+        receiver = null;
+        super.onDestroy();
+    }
+}
