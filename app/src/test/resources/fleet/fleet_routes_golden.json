{
  "about": "Golden request/response pairs for the fleet HTTP API (FleetRoutes). Recorded from 1.283 before the FleetRoutes split and replayed against every later build: a change here is a wire change. ${TOKEN} is the device token, ${TMP} a fresh temp directory holding hello.txt ('hello fleet') and sub/. auth: 'none' sends no Authorization header, 'good' sends 'Bearer ${TOKEN}', anything else is sent verbatim. setup: 'devMode' turns developer mode on first. JSON bodies are compared structurally (key order is a map detail).",
  "cases": [
    {"name": "auth: no header on a real route", "method": "GET", "path": "/info", "auth": "none", "expect": {"status": 401, "json": {"ok": false, "error": "unauthorized"}}},
    {"name": "auth: no header on an unknown route is still 401, not 404", "method": "GET", "path": "/nope", "auth": "none", "expect": {"status": 401, "json": {"ok": false, "error": "unauthorized"}}},
    {"name": "auth: no header on a write route", "method": "POST", "path": "/fs/write", "query": "path=${TMP}/x", "auth": "none", "body": "abc", "expect": {"status": 401, "json": {"ok": false, "error": "unauthorized"}}},
    {"name": "auth: wrong token of the same length", "method": "GET", "path": "/nope", "auth": "Bearer 0123456789abcdef0123456789abcdee", "expect": {"status": 401, "json": {"ok": false, "error": "unauthorized"}}},
    {"name": "auth: wrong token of another length", "method": "GET", "path": "/nope", "auth": "Bearer 0123", "expect": {"status": 401, "json": {"ok": false, "error": "unauthorized"}}},
    {"name": "auth: token with an extra character", "method": "GET", "path": "/nope", "auth": "Bearer ${TOKEN}0", "expect": {"status": 401, "json": {"ok": false, "error": "unauthorized"}}},
    {"name": "auth: empty bearer", "method": "GET", "path": "/nope", "auth": "Bearer ", "expect": {"status": 401, "json": {"ok": false, "error": "unauthorized"}}},
    {"name": "auth: scheme is case-sensitive", "method": "GET", "path": "/nope", "auth": "bearer ${TOKEN}", "expect": {"status": 401, "json": {"ok": false, "error": "unauthorized"}}},
    {"name": "auth: another scheme", "method": "GET", "path": "/nope", "auth": "Basic ${TOKEN}", "expect": {"status": 401, "json": {"ok": false, "error": "unauthorized"}}},
    {"name": "auth: a bare token (no scheme) is accepted", "method": "GET", "path": "/nope", "auth": "${TOKEN}", "expect": {"status": 404, "json": {"ok": false, "error": "not_found"}}},
    {"name": "auth: surrounding spaces are trimmed", "method": "GET", "path": "/nope", "auth": "Bearer    ${TOKEN}   ", "expect": {"status": 404, "json": {"ok": false, "error": "not_found"}}},
    {"name": "routing: unknown path", "method": "GET", "path": "/nope", "expect": {"status": 404, "json": {"ok": false, "error": "not_found"}}},
    {"name": "routing: paths are exact (trailing slash)", "method": "GET", "path": "/info/", "expect": {"status": 404, "json": {"ok": false, "error": "not_found"}}},
    {"name": "routing: paths are case-sensitive", "method": "GET", "path": "/INFO", "expect": {"status": 404, "json": {"ok": false, "error": "not_found"}}},
    {"name": "routing: /backup alone is not a backup route", "method": "GET", "path": "/backup", "expect": {"status": 404, "json": {"ok": false, "error": "not_found"}}},
    {"name": "routing: /perf/ prefix alone is unknown", "method": "GET", "path": "/perf/nope", "expect": {"status": 404, "json": {"ok": false, "error": "not_found"}}},
    {"name": "method: POST /info", "method": "POST", "path": "/info", "expect": {"status": 405, "json": {"ok": false, "error": "method_not_allowed"}}},
    {"name": "method: POST /apps", "method": "POST", "path": "/apps", "expect": {"status": 405, "json": {"ok": false, "error": "method_not_allowed"}}},
    {"name": "method: GET /install", "method": "GET", "path": "/install", "expect": {"status": 405, "json": {"ok": false, "error": "method_not_allowed"}}},
    {"name": "method: GET /update", "method": "GET", "path": "/update", "expect": {"status": 405, "json": {"ok": false, "error": "method_not_allowed"}}},
    {"name": "method: PUT /dev", "method": "PUT", "path": "/dev", "expect": {"status": 405, "json": {"ok": false, "error": "method_not_allowed"}}},
    {"name": "method: GET /config", "method": "GET", "path": "/config", "expect": {"status": 405, "json": {"ok": false, "error": "method_not_allowed"}}},
    {"name": "method: DELETE /calendar", "method": "DELETE", "path": "/calendar", "expect": {"status": 405, "json": {"ok": false, "error": "method_not_allowed"}}},
    {"name": "method: PUT /screensaver", "method": "PUT", "path": "/screensaver", "expect": {"status": 405, "json": {"ok": false, "error": "method_not_allowed"}}},
    {"name": "method: GET /action", "method": "GET", "path": "/action", "expect": {"status": 405, "json": {"ok": false, "error": "method_not_allowed"}}},
    {"name": "method: POST /fs/list", "method": "POST", "path": "/fs/list", "expect": {"status": 405, "json": {"ok": false, "error": "method_not_allowed"}}},
    {"name": "method: POST /fs/read", "method": "POST", "path": "/fs/read", "expect": {"status": 405, "json": {"ok": false, "error": "method_not_allowed"}}},
    {"name": "method: GET /fs/write", "method": "GET", "path": "/fs/write", "expect": {"status": 405, "json": {"ok": false, "error": "method_not_allowed"}}},
    {"name": "method: POST /logcat", "method": "POST", "path": "/logcat", "expect": {"status": 405, "json": {"ok": false, "error": "method_not_allowed"}}},
    {"name": "method: POST /diag", "method": "POST", "path": "/diag", "expect": {"status": 405, "json": {"ok": false, "error": "method_not_allowed"}}},
    {"name": "method: PUT /perf", "method": "PUT", "path": "/perf", "expect": {"status": 405, "json": {"ok": false, "error": "method_not_allowed"}}},
    {"name": "method: POST /perf/state", "method": "POST", "path": "/perf/state", "expect": {"status": 405, "json": {"ok": false, "error": "method_not_allowed"}}},
    {"name": "method: POST /perf/filmstrip-render", "method": "POST", "path": "/perf/filmstrip-render", "expect": {"status": 405, "json": {"ok": false, "error": "method_not_allowed"}}},
    {"name": "method: POST /perf/recent-apps", "method": "POST", "path": "/perf/recent-apps", "expect": {"status": 405, "json": {"ok": false, "error": "method_not_allowed"}}},
    {"name": "method: POST /perf/webapp-startup", "method": "POST", "path": "/perf/webapp-startup", "expect": {"status": 405, "json": {"ok": false, "error": "method_not_allowed"}}},
    {"name": "method: POST /perf/tools-discovery", "method": "POST", "path": "/perf/tools-discovery", "expect": {"status": 405, "json": {"ok": false, "error": "method_not_allowed"}}},
    {"name": "method: POST /perf/remote-input", "method": "POST", "path": "/perf/remote-input", "expect": {"status": 405, "json": {"ok": false, "error": "method_not_allowed"}}},
    {"name": "method: GET /backup/export", "method": "GET", "path": "/backup/export", "expect": {"status": 405, "json": {"ok": false, "error": "method_not_allowed"}}},
    {"name": "method: GET /backup/import", "method": "GET", "path": "/backup/import", "expect": {"status": 405, "json": {"ok": false, "error": "method_not_allowed"}}},
    {"name": "method: PUT /backup/key", "method": "PUT", "path": "/backup/key", "expect": {"status": 405, "json": {"ok": false, "error": "method_not_allowed"}}},
    {"name": "method: PUT /update/ota", "method": "PUT", "path": "/update/ota", "expect": {"status": 405, "json": {"ok": false, "error": "method_not_allowed"}}},
    {"name": "ota: bad json", "method": "POST", "path": "/update/ota", "body": "{nope", "expect": {"status": 400, "json": {"ok": false, "error": "bad_json"}}},
    {"name": "ota: action outside the allow-list", "method": "POST", "path": "/update/ota", "body": "{\"action\":\"downgrade\"}", "expect": {"status": 400, "json": {"ok": false, "error": "unknown_action"}}},
    {"name": "ota: no action", "method": "POST", "path": "/update/ota", "body": "{}", "expect": {"status": 400, "json": {"ok": false, "error": "unknown_action"}}},
    {"name": "install: bad json", "method": "POST", "path": "/install", "body": "[1,2]", "expect": {"status": 400, "json": {"ok": false, "error": "bad_json"}}},
    {"name": "install: empty body needs a package", "method": "POST", "path": "/install", "body": "", "expect": {"status": 400, "json": {"ok": false, "error": "packageName_required"}}},
    {"name": "install: blank package", "method": "POST", "path": "/install", "body": "{\"packageName\":\"  \"}", "expect": {"status": 400, "json": {"ok": false, "error": "packageName_required"}}},
    {"name": "install: a device-side APK needs dev mode", "method": "POST", "path": "/install", "body": "{\"path\":\"${TMP}/hello.txt\"}", "expect": {"status": 403, "json": {"ok": false, "error": "dev_mode_required"}}},
    {"name": "install: dev mode, missing APK", "method": "POST", "path": "/install", "setup": ["devMode"], "body": "{\"path\":\"${TMP}/missing.apk\",\"packageName\":\"a.b\"}", "expect": {"status": 404, "json": {"ok": false, "error": "file_not_found"}}},
    {"name": "install: dev mode, a directory is not an APK", "method": "POST", "path": "/install", "setup": ["devMode"], "body": "{\"path\":\"${TMP}/sub\"}", "expect": {"status": 404, "json": {"ok": false, "error": "file_not_found"}}},
    {"name": "install: apkUrl off the allow-list (http)", "method": "POST", "path": "/install", "body": "{\"packageName\":\"a.b\",\"apkUrl\":\"http://f-droid.org/x.apk\"}", "expect": {"status": 400, "json": {"ok": false, "error": "apk_url_not_allowed"}}},
    {"name": "install: apkUrl on a LAN host", "method": "POST", "path": "/install", "body": "{\"packageName\":\"a.b\",\"apkUrl\":\"https://192.168.1.10/x.apk\"}", "expect": {"status": 400, "json": {"ok": false, "error": "apk_url_not_allowed"}}},
    {"name": "install: apkUrl on an unknown host", "method": "POST", "path": "/install", "body": "{\"packageName\":\"a.b\",\"apkUrl\":\"https://evil.example/x.apk\"}", "expect": {"status": 400, "json": {"ok": false, "error": "apk_url_not_allowed"}}},
    {"name": "install: catalog not loaded yet", "method": "POST", "path": "/install", "body": "{\"packageName\":\"a.b\"}", "expect": {"status": 503, "json": {"ok": false, "error": "catalog_not_ready"}}},
    {"name": "update: bad json", "method": "POST", "path": "/update", "body": "nope", "expect": {"status": 400, "json": {"ok": false, "error": "bad_json"}}},
    {"name": "update: needs all or a package", "method": "POST", "path": "/update", "body": "{}", "expect": {"status": 400, "json": {"ok": false, "error": "specify_all_or_packageName"}}},
    {"name": "update: all, catalog not loaded", "method": "POST", "path": "/update", "body": "{\"all\":true}", "expect": {"status": 503, "json": {"ok": false, "error": "catalog_not_ready"}}},
    {"name": "update: dry run, catalog not loaded", "method": "POST", "path": "/update", "body": "{\"dryRun\":true}", "expect": {"status": 503, "json": {"ok": false, "error": "catalog_not_ready"}}},
    {"name": "apps: catalog not loaded", "method": "GET", "path": "/apps", "expect": {"status": 503, "json": {"ok": false, "error": "catalog_not_ready"}}},
    {"name": "dev: status", "method": "GET", "path": "/dev", "expect": {"status": 200, "json": {"ok": true, "dev": {"enabled": false, "versionCode": 0, "versionName": ""}}}},
    {"name": "dev: bad json", "method": "POST", "path": "/dev", "body": "{", "expect": {"status": 400, "json": {"ok": false, "error": "bad_json"}}},
    {"name": "dev: turn on", "method": "POST", "path": "/dev", "body": "{\"enabled\":true}", "expect": {"status": 200, "json": {"ok": true, "dev": {"enabled": true, "versionCode": 0, "versionName": ""}}}},
    {"name": "dev: a body without enabled changes nothing", "method": "POST", "path": "/dev", "setup": ["devMode"], "body": "{}", "expect": {"status": 200, "json": {"ok": true, "dev": {"enabled": true, "versionCode": 0, "versionName": ""}}}},
    {"name": "config: bad json", "method": "POST", "path": "/config", "body": "nope", "expect": {"status": 400, "json": {"ok": false, "error": "bad_json"}}},
    {"name": "config: empty body reads back", "method": "POST", "path": "/config", "body": "", "expect": {"status": 200, "json": {"ok": true, "name": "Portal", "config": {}}}},
    {"name": "config: name and free-form values", "method": "POST", "path": "/config", "body": "{\"name\":\"Kitchen\",\"set\":{\"wall\":\"north\",\"n\":3}}", "expect": {"status": 200, "json": {"ok": true, "name": "Kitchen", "config": {"wall": "north", "n": "3"}}}},
    {"name": "calendar: bad json", "method": "POST", "path": "/calendar", "body": "nope", "expect": {"status": 400, "json": {"ok": false, "error": "bad_json"}}},
    {"name": "screensaver: bad json", "method": "POST", "path": "/screensaver", "body": "nope", "expect": {"status": 400, "json": {"ok": false, "error": "bad_json"}}},
    {"name": "action: bad json", "method": "POST", "path": "/action", "body": "nope", "expect": {"status": 400, "json": {"ok": false, "error": "bad_json"}}},
    {"name": "action: none named", "method": "POST", "path": "/action", "body": "{}", "expect": {"status": 400, "json": {"ok": false, "error": "unknown_action"}}},
    {"name": "action: outside the allow-list", "method": "POST", "path": "/action", "body": "{\"action\":\"shell\"}", "expect": {"status": 400, "json": {"ok": false, "error": "unknown_action"}}},
    {"name": "action: names are case-sensitive", "method": "POST", "path": "/action", "body": "{\"action\":\"Reboot\"}", "expect": {"status": 400, "json": {"ok": false, "error": "unknown_action"}}},
    {"name": "action: reboot is reported as not permitted", "method": "POST", "path": "/action", "body": "{\"action\":\"reboot\"}", "expect": {"status": 200, "json": {"ok": false, "action": "reboot", "result": "not_permitted"}}},
    {"name": "action: settings_sync op outside the allow-list", "method": "POST", "path": "/action", "body": "{\"action\":\"settings_sync\",\"op\":\"wipe\"}", "expect": {"status": 400, "json": {"ok": false, "error": "bad_op"}}},
    {"name": "action: phone_test_session needs an op", "method": "POST", "path": "/action", "body": "{\"action\":\"phone_test_session\"}", "expect": {"status": 400, "json": {"ok": false, "error": "bad_op"}}},
    {"name": "action: phone_test_session op outside the allow-list", "method": "POST", "path": "/action", "body": "{\"action\":\"phone_test_session\",\"op\":\"grant\"}", "expect": {"status": 400, "json": {"ok": false, "error": "bad_op"}}},
    {"name": "action: revoke_id needs 16 lower-case hex (15)", "method": "POST", "path": "/action", "body": "{\"action\":\"phone_test_session\",\"op\":\"revoke_id\",\"id\":\"0123456789abcde\"}", "expect": {"status": 400, "json": {"ok": false, "error": "bad_id"}}},
    {"name": "action: revoke_id needs 16 lower-case hex (17)", "method": "POST", "path": "/action", "body": "{\"action\":\"phone_test_session\",\"op\":\"revoke_id\",\"id\":\"0123456789abcdef0\"}", "expect": {"status": 400, "json": {"ok": false, "error": "bad_id"}}},
    {"name": "action: revoke_id needs 16 lower-case hex (upper)", "method": "POST", "path": "/action", "body": "{\"action\":\"phone_test_session\",\"op\":\"revoke_id\",\"id\":\"0123456789ABCDEF\"}", "expect": {"status": 400, "json": {"ok": false, "error": "bad_id"}}},
    {"name": "action: revoke_id needs an id", "method": "POST", "path": "/action", "body": "{\"action\":\"phone_test_session\",\"op\":\"revoke_id\"}", "expect": {"status": 400, "json": {"ok": false, "error": "bad_id"}}},
    {"name": "action: age needs days", "method": "POST", "path": "/action", "body": "{\"action\":\"phone_test_session\",\"op\":\"age\"}", "expect": {"status": 400, "json": {"ok": false, "error": "bad_days"}}},
    {"name": "action: age below 0", "method": "POST", "path": "/action", "body": "{\"action\":\"phone_test_session\",\"op\":\"age\",\"days\":-1}", "expect": {"status": 400, "json": {"ok": false, "error": "bad_days"}}},
    {"name": "action: age above 400", "method": "POST", "path": "/action", "body": "{\"action\":\"phone_test_session\",\"op\":\"age\",\"days\":401}", "expect": {"status": 400, "json": {"ok": false, "error": "bad_days"}}},
    {"name": "action: screensaver_test_source minutes 0", "method": "POST", "path": "/action", "body": "{\"action\":\"screensaver_test_source\",\"enabled\":true,\"minutes\":0}", "expect": {"status": 400, "json": {"ok": false, "error": "bad_minutes"}}},
    {"name": "action: screensaver_test_source minutes 241", "method": "POST", "path": "/action", "body": "{\"action\":\"screensaver_test_source\",\"enabled\":true,\"minutes\":241}", "expect": {"status": 400, "json": {"ok": false, "error": "bad_minutes"}}},
    {"name": "action: cc_debug fakeState must be an object", "method": "POST", "path": "/action", "body": "{\"action\":\"cc_debug\",\"fakeState\":\"leak\"}", "expect": {"status": 400, "json": {"ok": false, "error": "bad_fakeState"}}},
    {"name": "action: open_screen outside the allow-list opens nothing", "method": "POST", "path": "/action", "body": "{\"action\":\"open_screen\",\"screen\":\"com.evil.Activity\"}", "expect": {"status": 200, "json": {"ok": false, "action": "open_screen"}}},
    {"name": "action: open_screen with no screen", "method": "POST", "path": "/action", "body": "{\"action\":\"open_screen\"}", "expect": {"status": 200, "json": {"ok": false, "action": "open_screen"}}},
    {"name": "fs/list: private data dir", "method": "GET", "path": "/fs/list", "query": "path=%2Fdata%2Fdata%2Fcom.immortal.launcher.debug%2Fshared_prefs", "expect": {"status": 403, "json": {"ok": false, "error": "protected_path"}}},
    {"name": "fs/list: /data/user alias", "method": "GET", "path": "/fs/list", "query": "path=/data/user/0/com.immortal.launcher.debug", "expect": {"status": 403, "json": {"ok": false, "error": "protected_path"}}},
    {"name": "fs/list: the fleet manifest dir", "method": "GET", "path": "/fs/list", "query": "path=/sdcard/Android/data/com.immortal.launcher.debug/files/fleet", "expect": {"status": 403, "json": {"ok": false, "error": "protected_path"}}},
    {"name": "fs/list: /proc side door", "method": "GET", "path": "/fs/list", "query": "path=/proc/self/fd", "expect": {"status": 403, "json": {"ok": false, "error": "protected_path"}}},
    {"name": "fs/list: dot-dot into private data", "method": "GET", "path": "/fs/list", "query": "path=/sdcard/../data/data/com.immortal.launcher.debug", "expect": {"status": 403, "json": {"ok": false, "error": "protected_path"}}},
    {"name": "fs/list: a directory", "method": "GET", "path": "/fs/list", "query": "path=${TMP}", "expect": {"status": 200, "json": {"ok": true, "path": "${TMP}", "entries": [{"name": "sub", "type": "dir", "size": 0, "mtime": 1700000000000, "readable": true}, {"name": "hello.txt", "type": "file", "size": 11, "mtime": 1700000000000, "readable": true}]}}},
    {"name": "fs/list: a missing path is a 200 with an error body", "method": "GET", "path": "/fs/list", "query": "path=${TMP}/missing", "expect": {"status": 200, "json": {"ok": false, "error": "not_found"}}},
    {"name": "fs/list: a file is not a directory", "method": "GET", "path": "/fs/list", "query": "path=${TMP}/hello.txt", "expect": {"status": 200, "json": {"ok": false, "error": "not_a_directory"}}},
    {"name": "fs/read: needs a path", "method": "GET", "path": "/fs/read", "expect": {"status": 400, "json": {"ok": false, "error": "path_required"}}},
    {"name": "fs/read: private data", "method": "GET", "path": "/fs/read", "query": "path=/data/data/com.immortal.launcher.debug/shared_prefs/fleet_agent.xml", "expect": {"status": 403, "json": {"ok": false, "error": "protected_path"}}},
    {"name": "fs/read: the fleet manifest", "method": "GET", "path": "/fs/read", "query": "path=/sdcard/Android/data/com.immortal.launcher.debug/files/fleet/agent.json", "expect": {"status": 403, "json": {"ok": false, "error": "protected_path"}}},
    {"name": "fs/read: /proc/self/environ", "method": "GET", "path": "/fs/read", "query": "path=/proc/self/environ", "expect": {"status": 403, "json": {"ok": false, "error": "protected_path"}}},
    {"name": "fs/read: a missing file", "method": "GET", "path": "/fs/read", "query": "path=${TMP}/missing", "expect": {"status": 404, "json": {"ok": false, "error": "not_a_readable_file"}}},
    {"name": "fs/read: a directory", "method": "GET", "path": "/fs/read", "query": "path=${TMP}/sub", "expect": {"status": 404, "json": {"ok": false, "error": "not_a_readable_file"}}},
    {"name": "fs/read: a file streams as an attachment", "method": "GET", "path": "/fs/read", "query": "path=${TMP}/hello.txt", "expect": {"status": 200, "contentType": "application/octet-stream", "length": 11, "headers": {"Content-Disposition": "attachment; filename=\"hello.txt\"; filename*=UTF-8''hello.txt"}, "text": "hello fleet"}},
    {"name": "fs/write: needs a path", "method": "POST", "path": "/fs/write", "body": "abc", "expect": {"status": 400, "json": {"ok": false, "error": "path_required"}}},
    {"name": "fs/write: private data", "method": "POST", "path": "/fs/write", "query": "path=/data/data/com.immortal.launcher.debug/shared_prefs/x.xml", "body": "abc", "expect": {"status": 403, "json": {"ok": false, "error": "protected_path"}}},
    {"name": "fs/write: over the 512 MiB cap", "method": "POST", "path": "/fs/write", "query": "path=${TMP}/big.bin", "contentLength": 536870913, "expect": {"status": 413, "json": {"ok": false, "error": "body_too_large", "maxBytes": 536870912, "minFreeAfterBytes": 268435456}}},
    {"name": "fs/write: a body shorter than its length", "method": "POST", "path": "/fs/write", "query": "path=${TMP}/short.bin", "body": "abc", "contentLength": 10, "expect": {"status": 400, "json": {"ok": false, "error": "write_failed", "detail": "Incomplete upload body"}}},
    {"name": "fs/write: writes a file", "method": "POST", "path": "/fs/write", "query": "path=${TMP}/new%20dir/up.txt", "body": "uploaded", "expect": {"status": 200, "json": {"ok": true, "path": "${TMP}/new dir/up.txt", "bytes": 8}, "file": {"path": "${TMP}/new dir/up.txt", "text": "uploaded"}}},
    {"name": "perf: bad json", "method": "POST", "path": "/perf", "body": "nope", "expect": {"status": 400, "json": {"ok": false, "error": "invalid_capture_command"}}},
    {"name": "perf: unknown command", "method": "POST", "path": "/perf", "body": "{\"action\":\"pause\"}", "expect": {"status": 400, "json": {"ok": false, "error": "invalid_capture_command"}}},
    {"name": "perf: start needs dev mode", "method": "POST", "path": "/perf", "body": "{\"action\":\"start\"}", "expect": {"status": 403, "json": {"ok": false, "error": "dev_mode_required"}}},
    {"name": "calendar: read", "method": "GET", "path": "/calendar", "expect": {"status": 200, "json": {"calendar": {"side": "right", "hasLink": false, "size": 1, "ranges": ["day", "3day", "week", "agenda"], "provider": "", "range": "day", "widgetOn": true, "url": "", "enabled": false, "supported": false}, "ok": true}}},
