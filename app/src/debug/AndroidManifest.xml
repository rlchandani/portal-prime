<?xml version="1.0" encoding="utf-8"?>
<!--
  Debug-only overrides. Exports the screensaver preview activity so the face-renderer
  iteration harness can launch it over adb with a "face_json" string extra (a mantelframe
  WidgetConfig-shaped face). Not merged into release builds, so the activity stays
  unexported there. See PhotoFramePreviewActivity for how the extra is read.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <application>
        <activity
            android:name=".MusicDesignPreviewActivity"
            android:exported="true"
            android:label="Silent music design preview"
            android:theme="@style/Theme.SampleApp" />
        <activity
            android:name=".PhotoFramePreviewActivity"
            android:exported="true"
            tools:replace="android:exported" />

        <!-- PREVIEW-ONLY design mocks. Debug-only (not merged into release). Launch over adb, e.g.
             adb shell am start -n com.immortal.launcher.debug/com.immortal.launcher.mock.IosWidgetsMockActivity -->
        <activity
            android:name=".TvDashboardMockActivity"
            android:exported="true"
            android:theme="@style/Theme.SampleApp">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>
        <activity
            android:name=".mock.IosWidgetsMockActivity"
            android:exported="true"
            android:label="iOS 26 Widgets"
            android:theme="@style/Theme.SampleApp">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>
        <activity
            android:name=".mock.IosHomeMockActivity"
            android:exported="true"
            android:screenOrientation="landscape"
            android:theme="@style/Theme.SampleApp">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>
        <activity
            android:name=".mock.IosStoreMockActivity"
            android:exported="true"
            android:label="iOS Store Mock"
            android:theme="@style/Theme.SampleApp">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>
        <activity
            android:name=".mock.IosSettingsMockActivity"
            android:exported="true"
            android:label="iOS Settings Mock"
            android:theme="@style/Theme.SampleApp">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>
    </application>
</manifest>
